{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dfrbagley-cpu/health-data-edge-cases/blob/main/schema/verification-result.schema.json",
  "title": "Health Data Edge Cases Verification Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "suite_version",
    "catalog_digest",
    "status",
    "passed",
    "passed_count",
    "case_count",
    "expectation_count",
    "mismatch_count",
    "cases",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "catalog_id": {
      "const": "health-data-edge-cases"
    },
    "suite_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["pass", "fail", "error"]
    },
    "passed": {
      "type": "boolean"
    },
    "passed_count": {
      "type": "integer",
      "minimum": 0
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "expectation_count": {
      "type": "integer",
      "minimum": 0
    },
    "mismatch_count": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "error"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "passed": {"const": false},
          "cases": {"maxItems": 0},
          "errors": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "cases": {"minItems": 1},
          "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "pass"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "passed": {"const": true},
          "mismatch_count": {"const": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "fail"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "passed": {"const": false},
          "mismatch_count": {"minimum": 1}
        }
      }
    }
  ],
  "$defs": {
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+$"
        }
      }
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "expected", "actual", "scope"],
      "properties": {
        "kind": {"enum": ["missing", "unexpected", "value"]},
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {
          "type": ["string", "null"],
          "pattern": "^-?[0-9]+$"
        },
        "actual": {
          "type": ["string", "null"],
          "pattern": "^-?[0-9]+$"
        },
        "scope": {"enum": ["metrics", "quality"]}
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "title",
        "principle",
        "naive_failure",
        "expected_resolution",
        "expected_metrics",
        "actual_metrics",
        "expected_quality",
        "actual_quality",
        "mismatches",
        "passed",
        "expectation_count"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {"type": "string", "minLength": 8},
        "principle": {"type": "string", "minLength": 20},
        "naive_failure": {"type": "string", "minLength": 20},
        "expected_resolution": {"type": "string", "minLength": 20},
        "expected_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/expectation"}
        },
        "actual_metrics": {
          "type": "array",
          "items": {"$ref": "#/$defs/expectation"}
        },
        "expected_quality": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/expectation"}
        },
        "actual_quality": {
          "type": "array",
          "items": {"$ref": "#/$defs/expectation"}
        },
        "mismatches": {
          "type": "array",
          "items": {"$ref": "#/$defs/mismatch"}
        },
        "passed": {"type": "boolean"},
        "expectation_count": {"type": "integer", "minimum": 1}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"const": "invalid_input"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
